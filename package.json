{
  "name": "@perkos/shared-types",
  "version": "0.3.0",
  "description": "Shared TypeScript types + Zod schemas for the PerkOS platform.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "perkos",
    "types",
    "zod",
    "schemas"
  ],
  "author": "PerkOS <julio.cruz@eb-ms.net>",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerkOS-xyz/PerkOS-Shared-Types.git"
  },
  "bugs": {
    "url": "https://github.com/PerkOS-xyz/PerkOS-Shared-Types/issues"
  },
  "homepage": "https://github.com/PerkOS-xyz/PerkOS-Shared-Types#readme"
}
